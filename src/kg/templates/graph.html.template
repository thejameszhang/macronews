<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Macroeconomic News Knowledge Graph — {{TITLE}}</title>
<style>
  html, body { margin: 0; height: 100%; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; overflow: hidden; }
  #kg-container { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
  #kg-legend {
    position: fixed; top: 10px; right: 10px; background: rgba(255,255,255,0.96);
    border: 1px solid #ccc; border-radius: 6px; padding: 10px 12px; font-size: 13px;
    max-height: 92vh; overflow-y: auto; z-index: 10; box-shadow: 0 2px 8px rgba(0,0,0,.15);
    min-width: 190px;
  }
  #kg-legend h4 { margin: 8px 0 4px; font-size: 14px; }
  #kg-legend ul { list-style: none; padding: 0; margin: 0; }
  #kg-legend li { display: flex; align-items: center; margin: 2px 0; cursor: pointer;
    padding: 2px 4px; border-radius: 3px; user-select: none; }
  #kg-legend li:hover { background: rgba(0,0,0,.06); }
  #kg-legend li.kg-off { opacity: .4; text-decoration: line-through; }
  .kg-swatch { width: 13px; height: 13px; margin-right: 7px; border-radius: 3px;
    border: 1px solid #999; flex-shrink: 0; display: inline-block; }
  #kg-legend .count { color: #888; margin-left: 4px; }
  #kg-controls { position: fixed; top: 10px; left: 10px; z-index: 10;
    background: rgba(255,255,255,0.96); border: 1px solid #ccc; border-radius: 6px;
    padding: 10px 12px; font-size: 13px; box-shadow: 0 2px 8px rgba(0,0,0,.15);
    width: 220px; }
  #kg-controls .kg-btn-row { display: flex; gap: 6px; flex-wrap: nowrap; margin: 6px 0; }
  #kg-controls button { font-size: 12px; padding: 4px 8px; cursor: pointer; }
  #kg-controls .kg-row { margin: 6px 0; }
  #kg-controls label { display: block; color: #444; margin-bottom: 2px; }
  #kg-controls input[type=range] { width: 100%; }
  #kg-controls input[type=text] { width: 100%; box-sizing: border-box; padding: 4px 6px;
    font-size: 13px; border: 1px solid #bbb; border-radius: 3px; }
  #kg-status { position: fixed; bottom: 10px; left: 10px; z-index: 10; font-size: 12px;
    color: #555; background: rgba(255,255,255,.85); padding: 3px 7px; border-radius: 3px; }
  #kg-tooltip { position: fixed; pointer-events: none; background: rgba(0,0,0,.85);
    color: #fff; padding: 6px 9px; border-radius: 4px; font-size: 12px; white-space: pre;
    z-index: 20; display: none; max-width: 360px; }
  /* Node-label overlay — always-on top-hub labels + sampled dynamic labels.
     Below legend/panel/tooltip (z-index 10-20) but above the canvas (z-index 0). */
  #kg-labels { position: fixed; inset: 0; pointer-events: none; z-index: 5; overflow: hidden; }
  .kg-label {
    position: absolute;
    transform: translate(-50%, -140%);
    white-space: nowrap;
    pointer-events: none;
    font-size: 10px;
    color: rgba(220, 220, 230, 0.85);
    text-shadow: 0 0 3px #000, 0 0 6px #000, 0 1px 2px rgba(0,0,0,.9);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    letter-spacing: 0.01em;
  }
  .kg-label-hub {
    font-size: 11.5px;
    color: rgba(245, 245, 255, 0.95);
    font-weight: bold;
    text-shadow: 0 0 4px #000, 0 0 8px #000, 0 1px 3px rgba(0,0,0,.95);
  }
  #kg-title{position:fixed;top:10px;left:50%;transform:translateX(-50%);z-index:10;text-align:center;pointer-events:none;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
  .kg-title-main{font-size:18px;font-weight:600;color:rgba(235,235,245,0.95);text-shadow:0 1px 4px rgba(0,0,0,.8)}
  .kg-title-sub{font-size:12px;color:rgba(200,200,215,0.8);margin-top:2px}
  .kg-edge-label {
    position: absolute;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    pointer-events: none;
    font-size: 10px;
    font-weight: 600;
    color: rgba(150, 200, 255, 0.98);          /* light blue, distinct from white node names */
    text-shadow: 0 0 3px #000, 0 0 6px #000, 0 1px 2px rgba(0,0,0,.95);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    letter-spacing: 0.01em;
  }
  #kg-panel {
    position: fixed; top: 0; right: 0; width: 320px; height: 100%;
    background: rgba(255,255,255,0.96); border-left: 1px solid #ccc;
    box-shadow: -2px 0 8px rgba(0,0,0,.15); z-index: 15;
    overflow-y: auto; font-size: 13px; padding: 12px;
    box-sizing: border-box;
  }
  #kg-panel[hidden] { display: none; }
  #kg-panel-close {
    float: right; background: none; border: none; font-size: 18px;
    cursor: pointer; color: #555; line-height: 1; padding: 0 2px;
  }
  #kg-panel-close:hover { color: #000; }
  #kg-panel-body h3 { margin: 0 0 4px; font-size: 15px; word-break: break-word; }
  .kg-panel-sub { color: #666; margin-bottom: 10px; }
  .kg-rels { list-style: none; padding: 0; margin: 0; }
  .kg-rels li { padding: 5px 0; border-bottom: 1px solid #eee; }
  .kg-rels li:last-child { border-bottom: none; }
  .kg-rel { display: block; word-break: break-word; }
  .kg-relmeta { display: block; color: #888; font-size: 11px; margin-top: 2px; }
  .kg-rel-row { cursor: pointer; }
  .kg-rel-row:hover { background: rgba(255,255,255,0.05); }
  #kg-modal { position: fixed; inset: 0; z-index: 30; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.55); }
  #kg-modal[hidden] { display: none; }
  .kg-modal-card { max-width: 520px; width: 90%; max-height: 70vh; overflow-y: auto; background: #15161c; color: #e8e8ec; border: 1px solid #2a2c36; border-radius: 8px; padding: 18px 20px; position: relative; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  #kg-modal-close { position: absolute; top: 10px; right: 12px; background: none; border: none; color: #888; font-size: 16px; cursor: pointer; line-height: 1; padding: 2px 4px; }
  #kg-modal-close:hover { color: #e8e8ec; }
  #kg-modal-title { font-weight: bold; font-size: 15px; margin-bottom: 10px; padding-right: 24px; word-break: break-word; }
  .kg-src { margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px solid #2a2c36; }
  .kg-src:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  .kg-src-head { font-weight: bold; font-size: 13px; word-break: break-word; }
  .kg-src-meta { font-size: 11px; color: #888; margin-top: 3px; }
  .kg-src-empty { color: #888; font-size: 13px; }
</style>
</head>
<body>
<div id="kg-title">
  <div class="kg-title-main">Macroeconomic News Knowledge Graph</div>
  <div class="kg-title-sub">{{TITLE}}</div>
</div>
<div id="kg-container"></div>
<div id="kg-labels"></div>
<div id="kg-controls">
  <div class="kg-row">
    <label>Min. articles per edge <span id="kg-mc-val">1</span></label>
    <input type="range" id="kg-mc" min="1" max="2" value="1">
  </div>
  <div class="kg-row">
    <label>Min. node degree <span id="kg-md-val">1</span></label>
    <input type="range" id="kg-md" min="1" max="2" value="1">
  </div>
  <div class="kg-btn-row">
    <button id="kg-apply">Apply filters</button>
    <button id="kg-play">Pause</button>
    <button id="kg-restart">Re-heat</button>
  </div>
  <div class="kg-row">
    <label>Repulsion <span id="kg-rep-val">0.4</span></label>
    <input type="range" id="kg-rep" min="0.1" max="2" step="0.05" value="0.4">
  </div>
  <div class="kg-row">
    <label>Gravity <span id="kg-grav-val">0.35</span></label>
    <input type="range" id="kg-grav" min="0" max="1" step="0.05" value="0.35">
  </div>
  <div class="kg-row">
    <input type="text" id="kg-search" placeholder="Search entity..." list="kg-node-list" autocomplete="off">
  </div>
  <datalist id="kg-node-list"></datalist>
</div>
<div id="kg-legend">{{LEGEND_HTML}}</div>
<div id="kg-status"></div>
<div id="kg-tooltip"></div>
<aside id="kg-panel" hidden>
  <button id="kg-panel-close" aria-label="close">&#x2715;</button>
  <div id="kg-panel-body"></div>
</aside>
<div id="kg-modal" hidden>
  <div class="kg-modal-card">
    <button id="kg-modal-close" aria-label="close">&#x2715;</button>
    <div id="kg-modal-title"></div>
    <div id="kg-modal-body"></div>
  </div>
</div>

<!-- cosmos.gl vendored bundle — exposes globalThis.cosmos = { Graph, getRgbaColor } -->
<script>{{VENDORED_JS}}</script>

<!-- Core graph renderer: data adaptation + cosmos.gl GPU physics.
     Shared objects are attached to window.kg so subsequent <script> blocks
     added by Tasks 3/4 (legend toggle, search, filter handlers) can reach them
     without relying on variable hoisting across separate script elements. -->
<script>
"use strict";
const DATA = {{GRAPH_DATA}};
const container = document.getElementById("kg-container");

// --- cosmos.gl config ---
const config = {
  spaceSize:              8192,
  backgroundColor:        "#0b0b12",
  curvedLinks:            false,
  enableDrag:             true,
  fitViewOnInit:          true,
  fitViewDelay:           1000,
  simulationRepulsion:    0.4,
  simulationGravity:      0.35,
  simulationLinkSpring:   1.9,
  simulationFriction:     0.85,
  simulationDecay:        5000,
  onSimulationEnd:        () => { if (typeof autoSettle === "function") autoSettle(); },
  onSimulationStart:      () => { if (typeof setRunning === "function") setRunning(true); },
  onSimulationTick:       () => { if (window.kgLabels && typeof window.kgLabels._tick === "function") window.kgLabels._tick(); },
  onDrag:                 () => { if (window.kgLabels && typeof window.kgLabels._tick === "function") window.kgLabels._tick(); },
  pointSamplingDistance:  180,
  pointGreyoutOpacity:    0.08,
  linkGreyoutOpacity:     0.03,
  hoveredPointRingColor:  "#e8e8ec",
  hoveredLinkColor:       "#e8e8ec",
  hoveredLinkWidthIncrease: 2,
  // Event hooks — Tasks 3/4 define the named handlers; guard so this script
  // works standalone if those scripts are absent.
  onClick:         (i)      => (typeof handleClick      === "function") && handleClick(i),
  onPointMouseOver:(i)      => (typeof handlePointOver  === "function") && handlePointOver(i),
  onPointMouseOut: ()       => (typeof handlePointOut   === "function") && handlePointOut(),
  onLinkMouseOver: (k)      => (typeof handleLinkOver   === "function") && handleLinkOver(k),
  onLinkMouseOut:  ()       => (typeof handleLinkOut    === "function") && handleLinkOut(),
  onLinkClick:     (k, ev)  => (typeof handleLinkClick  === "function") && handleLinkClick(k, ev),
};

// --- construct cosmos graph instance ---
const graph = new cosmos.Graph(container, config);

// --- expose shared state skeleton so Task-3/4 handlers can reference window.kg ---
// idx, nodeMeta, edgeMeta, adjacency are populated/updated by buildAndApply.
window.kg = { graph, idx: new Map(), nodeMeta: [], edgeMeta: [], adjacency: [], DATA };

// --- Play/Pause state — declared here so setRunning/buildAndApply can reference them ---
var running = true;
var playBtn = document.getElementById("kg-play");
function setRunning(on) { running = on; if (playBtn) playBtn.textContent = on ? "Pause" : "Play"; }

// autoSettle: called by onSimulationEnd callback and fallback setTimeout.
// Pauses the simulation and updates the Play/Pause button to reflect idle state.
// Also snapshots final positions so labels don't lag on a stopped sim.
function autoSettle() {
  try { graph.pause(); } catch (e) {}
  setRunning(false);
  if (window.kgLabels && typeof window.kgLabels._tick === "function") window.kgLabels._tick();
}

// -------------------------------------------------------------------------
// buildAndApply(nodes, edges, preserve)
//   nodes, edges  — the visible subset to render
//   preserve      — true: reuse current positions for nodes still present
//                   false: fresh ring-seed layout (initial render)
// -------------------------------------------------------------------------
function buildAndApply(nodes, edges, preserve) {
  // If preserving, capture positions BEFORE overwriting window.kg.idx/nodeMeta.
  var prevByKey = new Map();
  if (preserve) {
    var prevPos  = graph.getPointPositions();
    var prevMeta = window.kg.nodeMeta;
    prevMeta.forEach(function(n, i) {
      prevByKey.set(n.key, [prevPos[2*i], prevPos[2*i+1]]);
    });
  }

  // Build new index over the incoming node list.
  var N = nodes.length;
  var idx = new Map();
  nodes.forEach(function(n, i) { idx.set(n.key, i); });

  // --- positions: ring seed for fresh layout; saved position for preserved ---
  var positions = new Float32Array(N * 2);
  for (var i = 0; i < N; i++) {
    var key = nodes[i].key;
    if (preserve && prevByKey.has(key)) {
      var xy = prevByKey.get(key);
      positions[2*i]   = xy[0];
      positions[2*i+1] = xy[1];
    } else {
      // Same ring-seed formula as the original Task-2 init.
      var a = (i / N) * Math.PI * 2;
      positions[2*i]   = Math.cos(a) * 2000 + 4096;
      positions[2*i+1] = Math.sin(a) * 2000 + 4096;
    }
  }

  // --- point colors + sizes ---
  var pointColors = new Float32Array(N * 4);
  var pointSizes  = new Float32Array(N);
  nodes.forEach(function(n, i) {
    var c = cosmos.getRgbaColor(n.color);
    pointColors[4*i]   = c[0];
    pointColors[4*i+1] = c[1];
    pointColors[4*i+2] = c[2];
    pointColors[4*i+3] = 1;
    pointSizes[i] = n.size;
  });

  // --- edge arrays + metadata ---
  // edges from computeSubset already have both endpoints in nodes, but we
  // still guard via idx to stay robust against any future caller.
  var validEdges = edges.filter(function(e) { return idx.has(e.source) && idx.has(e.target); });
  if (validEdges.length !== edges.length) {
    console.warn("kg: dropped " + (edges.length - validEdges.length) +
                 " edge(s) referencing a missing node");
  }
  var E = validEdges.length;
  var links      = new Float32Array(E * 2);
  var linkColors = new Float32Array(E * 4);
  var linkWidths = new Float32Array(E);
  var edgeMeta   = new Array(E);
  var adjacency  = Array.from({ length: N }, function() { return []; });

  validEdges.forEach(function(e, k) {
    var s = idx.get(e.source), t = idx.get(e.target);
    links[2*k] = s; links[2*k+1] = t;
    var c = cosmos.getRgbaColor(e.color);
    linkColors[4*k]=c[0]; linkColors[4*k+1]=c[1]; linkColors[4*k+2]=c[2]; linkColors[4*k+3]=0.7;
    linkWidths[k] = Math.min(10, 2.5 + 1.5 * Math.log1p(e.count));
    edgeMeta[k] = { subject: e.source, relation: e.relationType, object: e.target, count: e.count, dateRange: e.dateRange };
    adjacency[s].push({ dir:"out", relation:e.relationType, other:e.target, count:e.count, dateRange:e.dateRange, sources: e.sources || [] });
    adjacency[t].push({ dir:"in",  relation:e.relationType, other:e.source, count:e.count, dateRange:e.dateRange, sources: e.sources || [] });
  });

  // --- push data to cosmos ---
  graph.setPointPositions(positions);
  graph.setPointColors(pointColors);
  graph.setPointSizes(pointSizes);
  graph.setLinks(links);
  graph.setLinkColors(linkColors);
  graph.setLinkWidths(linkWidths);
  graph.render();

  if (preserve) {
    graph.start(0.3); // gentle re-energize so preserved positions don't explode
    setRunning(true);
    setTimeout(function() { try { graph.fitView(400); } catch(e){} }, 600);
    // Fallback: settle and auto-pause if onSimulationEnd never fires.
    setTimeout(autoSettle, 4000);
    // Clear stale selection/panel.
    graph.unselectPoints();
    graph.setConfig({ focusedPointIndex: undefined });
    var p = document.getElementById("kg-panel");
    if (p) p.hidden = true;
    var lg = document.getElementById("kg-legend");
    if (lg) lg.style.right = "";
  } else {
    graph.start(1); // alpha=1: full-energy simulation start
    setRunning(true);
    // fitViewOnInit is sometimes unreliable on first paint; belt-and-suspenders call.
    setTimeout(function() { try { graph.fitView(400); } catch(e){} }, 1600);
    // Fallback: settle and auto-pause if onSimulationEnd never fires.
    setTimeout(autoSettle, 7000);
  }

  // --- update shared state so Task-3 handlers stay correct on the filtered view ---
  // window.kg.DATA and window.kg.graph are intentionally left unchanged.
  window.kg.idx      = idx;
  window.kg.nodeMeta = nodes;
  window.kg.edgeMeta = edgeMeta;
  window.kg.adjacency = adjacency;
  // Store base link colors so focus mode can derive spoke-isolation colors from
  // them and restore them on unfocus. buildAndApply already calls
  // setLinkColors(linkColors) above, so live colors == base after every rebuild.
  window.kg.baseLinkColors = linkColors;
  // Clear focus on every rebuild (filter change or fresh render); stale indices
  // are invalid after nodes are reassigned. Also clear arrows.
  window.kg.focus = null;
  try {
    var emptyArrows = new Array(E).fill(false);
    graph.setLinkArrows(emptyArrows);
  } catch(e) {}

  // Notify the label overlay module (Task 4) so it recomputes hubs + label set
  // for the new node/edge subset. Guard: module may not be loaded yet on initial
  // render (script runs after this one, but buildAndApply is called synchronously
  // at the bottom of this script, before the label module script executes).
  if (window.kgLabels && typeof window.kgLabels.onRebuild === "function") {
    window.kgLabels.onRebuild();
  }
}

// -------------------------------------------------------------------------
// Subset computation (mirrors Python filter_graph: edges-first, distinct-
// neighbor degree). hiddenTypes/hiddenRels are managed by handleLegendToggle.
// -------------------------------------------------------------------------
var hiddenTypes = new Set();
var hiddenRels  = new Set();

function computeSubset(minCount, minDegree) {
  var D = window.kg.DATA;
  var nodeByKey = new Map(D.nodes.map(function(n) { return [n.key, n]; }));
  function visible(n) { return n && !hiddenTypes.has(n.entityType); }
  var edges = D.edges.filter(function(e) {
    return (e.count || 1) >= minCount &&
           !hiddenRels.has(e.relationType) &&
           visible(nodeByKey.get(e.source)) &&
           visible(nodeByKey.get(e.target));
  });
  var deg = new Map();
  edges.forEach(function(e) {
    if (!deg.has(e.source)) deg.set(e.source, new Set());
    if (!deg.has(e.target)) deg.set(e.target, new Set());
    if (e.source !== e.target) {
      deg.get(e.source).add(e.target);
      deg.get(e.target).add(e.source);
    }
  });
  var keep = new Set(D.nodes.filter(function(n) {
    return visible(n) && (deg.has(n.key) ? deg.get(n.key).size : 0) >= minDegree;
  }).map(function(n) { return n.key; }));
  edges = edges.filter(function(e) { return keep.has(e.source) && keep.has(e.target); });
  var nodes = D.nodes.filter(function(n) { return keep.has(n.key); });
  return { nodes: nodes, edges: edges };
}

function currentThresholds() {
  var mc = parseInt((document.getElementById("kg-mc") || {}).value, 10) || 1;
  var md = parseInt((document.getElementById("kg-md") || {}).value, 10) || 1;
  return { mc: mc, md: md };
}

function applyView() {
  var t   = currentThresholds();
  var sub = computeSubset(t.mc, t.md);
  buildAndApply(sub.nodes, sub.edges, true);
  var st = document.getElementById("kg-status");
  if (st) st.textContent = sub.nodes.length + " nodes · " + sub.edges.length + " edges";
}

// -------------------------------------------------------------------------
// Named handlers expected by the core's typeof-guards + Task-3 script.
// -------------------------------------------------------------------------
window.handleLegendToggle = function(attr, name) {
  var set = (attr === "entitytype") ? hiddenTypes : hiddenRels;
  set.has(name) ? set.delete(name) : set.add(name);
  var escaped = (window.CSS && CSS.escape) ? CSS.escape(name) : name;
  var row = document.querySelector("[data-" + attr + "=\"" + escaped + "\"]");
  if (row) row.classList.toggle("kg-off", set.has(name));
  applyView();
};

// kgToggle is the entry-point called by legend row onclick handlers
// (built in build_legend_html as: kgToggle('entitytype'|'relationtype', NAME)).
window.kgToggle = window.handleLegendToggle;

// -------------------------------------------------------------------------
// Initial render — identical to the original Task-2 behavior:
// fresh ring-seed positions, full DATA, alpha=1, fitView at 1600ms.
// -------------------------------------------------------------------------
buildAndApply(DATA.nodes, DATA.edges, false);

// Set initial status.
(function() {
  var st = document.getElementById("kg-status");
  if (st) st.textContent = DATA.nodes.length + " nodes · " + DATA.edges.length + " edges";
})();

// -------------------------------------------------------------------------
// Controls bar wiring.
// -------------------------------------------------------------------------

// Slider display.
var mcSlider = document.getElementById("kg-mc");
var mdSlider = document.getElementById("kg-md");
var mcVal    = document.getElementById("kg-mc-val");
var mdVal    = document.getElementById("kg-md-val");
if (mcSlider) mcSlider.oninput = function() { mcVal.textContent = mcSlider.value; };
if (mdSlider) mdSlider.oninput = function() { mdVal.textContent = mdSlider.value; };

// Apply button.
var applyBtn = document.getElementById("kg-apply");
if (applyBtn) applyBtn.onclick = function() { applyView(); };

// Play/Pause toggle (running/playBtn/setRunning declared above, before buildAndApply).
if (playBtn) {
  playBtn.onclick = function() {
    var next = !running;
    next ? graph.unpause() : graph.pause();
    setRunning(next);
  };
}

// Re-heat (restart layout at full energy).
var restartBtn = document.getElementById("kg-restart");
if (restartBtn) restartBtn.onclick = function() { graph.start(1); setRunning(true); };

// Repulsion slider.
var repSlider = document.getElementById("kg-rep");
var repVal    = document.getElementById("kg-rep-val");
if (repSlider) {
  repSlider.oninput = function() {
    if (repVal) repVal.textContent = repSlider.value;
    graph.setConfig({ simulationRepulsion: parseFloat(repSlider.value) });
    graph.start(0.3);
  };
}

// Gravity slider.
var gravSlider = document.getElementById("kg-grav");
var gravVal    = document.getElementById("kg-grav-val");
if (gravSlider) {
  gravSlider.oninput = function() {
    if (gravVal) gravVal.textContent = gravSlider.value;
    graph.setConfig({ simulationGravity: parseFloat(gravSlider.value) });
    graph.start(0.3);
  };
}

// Search wiring.
var searchInput = document.getElementById("kg-search");
if (searchInput) {
  searchInput.addEventListener("change",  function() { (typeof handleSearch === "function") && handleSearch(searchInput.value); });
  searchInput.addEventListener("keydown", function(e) { if (e.key === "Enter") (typeof handleSearch === "function") && handleSearch(searchInput.value); });
}
</script>

<!-- Task 3: Inspection interactions — tooltips, node side panel, search -->
<script>
"use strict";
(function () {
  // Wait until window.kg is populated (core script runs synchronously, so it's
  // already set; the guard is belt-and-suspenders for any future async wrapping).
  const kg = window.kg;

  // ------------------------------------------------------------------ utils --
  function escapeHtml(s) {
    return String(s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  // --------------------------------------------------------------- tooltip --
  const tip = document.getElementById("kg-tooltip");
  let lastMouse = { x: 0, y: 0 };
  let pinned = false;
  let pinnedLink = null;

  document.addEventListener("mousemove", function (e) {
    lastMouse = { x: e.clientX, y: e.clientY };
    if (tip.style.display === "block" && !pinned) placeTip();
  });

  function placeTip() {
    tip.style.left = (lastMouse.x + 14) + "px";
    tip.style.top  = (lastMouse.y + 14) + "px";
  }
  function showTip(text) {
    tip.textContent = text;
    tip.style.display = "block";
    placeTip();
  }
  function hideTip() { if (!pinned) tip.style.display = "none"; }
  function unpin()   { pinned = false; pinnedLink = null; tip.style.display = "none"; }

  function nodeTipText(i) {
    const n = kg.nodeMeta[i];
    return n.label + "\nType: " + n.entityType + "\nAsserted in " + n.articleCount + " article(s)";
  }
  function edgeTipText(k) {
    const m = kg.edgeMeta[k];
    let s = m.subject + "  --[" + m.relation + "]-->  " + m.object +
            "\nAsserted in " + m.count + " article(s)";
    if (m.dateRange) s += "\n" + m.dateRange;
    return s;
  }

  window.handlePointOver = function (i) { if (pinned || i == null) return; showTip(nodeTipText(i)); };
  window.handlePointOut  = function ()  { hideTip(); };
  window.handleLinkOver  = function (k) { if (pinned || k == null) return; showTip(edgeTipText(k)); };
  window.handleLinkOut   = function ()  { hideTip(); };
  window.handleLinkClick = function (k) {
    if (k == null) return;
    if (pinned && pinnedLink === k) { unpin(); return; }   // click same pinned edge → dismiss
    pinned = true; pinnedLink = k; showTip(edgeTipText(k)); // click new edge → (re)pin
  };

  // --------------------------------------------------------- provenance modal --
  var modal      = document.getElementById("kg-modal");
  var modalTitle = document.getElementById("kg-modal-title");
  var modalBody  = document.getElementById("kg-modal-body");
  var currentPanelRels = [];

  function openModal(arrow, sources) {
    modalTitle.textContent = arrow;
    if (!sources || !sources.length) {
      modalBody.innerHTML = "<div class='kg-src-empty'>No source records.</div>";
    } else {
      modalBody.innerHTML = sources.map(function(s) {
        return "<div class='kg-src'>" +
          "<div class='kg-src-head'>" + escapeHtml(s.headline || "(no headline)") + "</div>" +
          "<div class='kg-src-meta'>" + escapeHtml((s.date || "") + " · " + (s.article_id || "")) + "</div>" +
          "</div>";
      }).join("");
    }
    modal.hidden = false;
  }
  function closeModal() { modal.hidden = true; }
  document.getElementById("kg-modal-close").onclick = closeModal;
  modal.addEventListener("click", function(e) { if (e.target === modal) closeModal(); });
  document.addEventListener("keydown", function(e) { if (e.key === "Escape" && !modal.hidden) closeModal(); });

  // Delegated click on panel rows — attached once here, not per panel build.
  document.getElementById("kg-panel-body").addEventListener("click", function(e) {
    var li = e.target.closest(".kg-rel-row");
    if (!li) return;
    var idx = parseInt(li.getAttribute("data-relidx"), 10);
    var entry = currentPanelRels[idx];
    if (entry) openModal(entry.arrow, entry.sources);
  });

  // ------------------------------------------------------------ side panel --
  const panel      = document.getElementById("kg-panel");
  const panelBody  = document.getElementById("kg-panel-body");
  const panelClose = document.getElementById("kg-panel-close");

  function closePanel() {
    panel.hidden = true;
    const legendEl = document.getElementById("kg-legend");
    if (legendEl) legendEl.style.right = "";
  }

  panelClose.onclick = function () {
    closePanel();
    kg.graph.unselectPoints();
    kg.graph.setConfig({ focusedPointIndex: undefined });
  };

  window.handleClick = function (i) {
    unpin();
    if (i == null) {
      // Background click: exit focus mode.
      kg.focus = null;
      closePanel();
      kg.graph.unselectPoints();
      kg.graph.setConfig({ focusedPointIndex: undefined });
      // Clear all link arrows.
      try {
        var emptyArr = new Array(kg.edgeMeta.length).fill(false);
        kg.graph.setLinkArrows(emptyArr);
      } catch(e) {}
      // Restore base link colors (undo spoke isolation from focus mode).
      if (window.kg.baseLinkColors) {
        try { kg.graph.setLinkColors(window.kg.baseLinkColors); } catch(e) {}
      }
      if (window.kgLabels && typeof window.kgLabels.onFocusChange === "function") {
        window.kgLabels.onFocusChange();
      }
      return;
    }
    const n    = kg.nodeMeta[i];
    const rels = kg.adjacency[i];

    // --- (c) Panel sort: by count desc, then dateRange desc (empty last),
    //         then alphabetical by arrow text.
    const sortedRels = rels.slice().sort(function(a, b) {
      if (b.count !== a.count) return b.count - a.count;
      // dateRange: non-empty sorts before empty; between two non-empty, descending.
      var da = a.dateRange || "", db = b.dateRange || "";
      if (da === "" && db !== "") return 1;
      if (da !== "" && db === "") return -1;
      if (da !== db) return db < da ? -1 : 1;
      // tie-break: alphabetical by arrow text.
      var arrowA = a.dir === "out"
        ? (n.label + " —[" + a.relation + "]→ " + a.other)
        : (a.other  + " —[" + a.relation + "]→ " + n.label);
      var arrowB = b.dir === "out"
        ? (n.label + " —[" + b.relation + "]→ " + b.other)
        : (b.other  + " —[" + b.relation + "]→ " + n.label);
      return arrowA < arrowB ? -1 : arrowA > arrowB ? 1 : 0;
    });

    currentPanelRels = [];
    const rows = sortedRels.map(function (r, ridx) {
      const arrow = r.dir === "out"
        ? (n.label + " —[" + r.relation + "]→ " + r.other)
        : (r.other  + " —[" + r.relation + "]→ " + n.label);
      const meta = r.count + " article(s)" + (r.dateRange ? " · " + r.dateRange : "");
      currentPanelRels.push({ arrow: arrow, sources: r.sources || [] });
      return "<li class=\"kg-rel-row\" data-relidx=\"" + ridx + "\">" +
        "<span class=\"kg-rel\">"     + escapeHtml(arrow) + "</span>" +
        "<span class=\"kg-relmeta\">" + escapeHtml(meta)  + "</span>" +
        "</li>";
    }).join("");

    panelBody.innerHTML =
      "<h3>"                 + escapeHtml(n.label) + "</h3>" +
      "<div class=\"kg-panel-sub\">" +
        escapeHtml(n.entityType + " · " + n.articleCount + " article(s) · " + rels.length + " relation(s)") +
      "</div>" +
      "<ul class=\"kg-rels\">" + rows + "</ul>";

    panel.hidden = false;
    const legendEl = document.getElementById("kg-legend");
    if (legendEl) legendEl.style.right = "330px";

    // --- (b) Focus mode: build neighbor ranking for label overlay.
    // Group adjacency by neighbor key; compute topCount per neighbor.
    var neighborMap = new Map(); // otherKey → { totalCount, relCounts: Map<rel,count> }
    rels.forEach(function(r) {
      if (!neighborMap.has(r.other)) {
        neighborMap.set(r.other, { topCount: 0, relCounts: new Map() });
      }
      var entry = neighborMap.get(r.other);
      if (r.count > entry.topCount) entry.topCount = r.count;
      var prev = entry.relCounts.get(r.relation) || 0;
      entry.relCounts.set(r.relation, prev + r.count);
    });
    // Rank distinct neighbors by topCount desc, tie-break alpha by key.
    var sortedNeighbors = Array.from(neighborMap.entries()).sort(function(a, b) {
      if (b[1].topCount !== a[1].topCount) return b[1].topCount - a[1].topCount;
      return a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0;
    }).slice(0, 50);
    // Build focus.neighbors — only include neighbors with a valid point index.
    var focusNeighbors = [];
    sortedNeighbors.forEach(function(entry) {
      var otherKey = entry[0];
      var info     = entry[1];
      var nbrIdx   = kg.idx.get(otherKey);
      if (nbrIdx == null) return;
      // Join relations sorted by combined count desc, then alpha.
      var relsSorted = Array.from(info.relCounts.entries()).sort(function(a, b) {
        if (b[1] !== a[1]) return b[1] - a[1];
        return a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0;
      });
      var relStr = relsSorted.map(function(e) { return e[0]; }).join(" / ");
      focusNeighbors.push({ idx: nbrIdx, relations: relStr });
    });

    // Set kg.focus FIRST — so any subsequent visual call that throws still
    // leaves focus state correctly set for the label overlay.
    kg.focus = { index: i, neighbors: focusNeighbors };

    // Highlight selected node + its neighbours; dim everything else.
    const nbr = rels
      .map(function (r) { return kg.idx.get(r.other); })
      .filter(function (x) { return x != null; });
    kg.graph.selectPointsByIndices([i].concat(nbr));
    kg.graph.setConfig({ focusedPointIndex: i });

    // --- Arrows: enable for every edge incident to the focused node.
    try {
      var arrows = new Array(kg.edgeMeta.length).fill(false);
      kg.edgeMeta.forEach(function(em, k) {
        if (kg.idx.get(em.subject) === i || kg.idx.get(em.object) === i) {
          arrows[k] = true;
        }
      });
      kg.graph.setLinkArrows(arrows);
    } catch(e) {}

    // --- Spoke isolation: bright the focused node's edges, dim everything else.
    try {
      var base = window.kg.baseLinkColors;
      if (base) {
        var fc = new Float32Array(base);              // copy base
        kg.edgeMeta.forEach(function(em, k) {
          var incident = (kg.idx.get(em.subject) === i || kg.idx.get(em.object) === i);
          if (incident) {                              // bright spoke
            fc[4*k] = 0.85; fc[4*k+1] = 0.90; fc[4*k+2] = 1.0; fc[4*k+3] = 0.95;
          } else {                                     // dim everything else
            fc[4*k+3] = 0.05;
          }
        });
        kg.graph.setLinkColors(fc);
      }
    } catch(e) {}

    // Notify label overlay to enter focus mode.
    if (window.kgLabels && typeof window.kgLabels.onFocusChange === "function") {
      window.kgLabels.onFocusChange();
    }
  };

  // --------------------------------------------------------------- search --
  // Populate datalist with one <option> per node label.
  const dl = document.getElementById("kg-node-list");
  if (dl) {
    const frag = document.createDocumentFragment();
    kg.DATA.nodes.forEach(function (n) {
      const opt = document.createElement("option");
      opt.value = n.label;
      frag.appendChild(opt);
    });
    dl.appendChild(frag);
  }

  // Build a label → node KEY lookup (first match wins for duplicates).
  // We resolve the live cosmos index via kg.idx.get(key) at search time so
  // that filtering (buildAndApply) doesn't leave us pointing at the wrong node.
  const labelToKey = new Map();
  kg.DATA.nodes.forEach(function (n) {
    if (!labelToKey.has(n.label)) labelToKey.set(n.label, n.key);
  });

  window.handleSearch = function (val) {
    if (!val) return;
    const key = labelToKey.get(val.trim());
    if (!key) return;
    const i = kg.idx.get(key);   // live current-render index; undefined if filtered out
    if (i == null) return;
    kg.graph.zoomToPointByIndex(i);
    window.handleClick(i);
  };

})();
</script>

<!-- Task 4: Dynamic node-label overlay — top-hub labels (always on) +
     sampled dynamic labels (zoom-appropriate spread via cosmos sampling API).
     Uses a span pool to avoid per-frame DOM allocation. Labels are positioned
     via space→screen projection every rAF tick (cheap: ~40 projections).
     GPU read (getPointPositions) is throttled to physics ticks + rebuild only. -->
<script>
"use strict";
(function () {
  var LABEL_MAX     = 50;    // hard cap on total labels rendered at once
  var HUB_COUNT     = 15;    // top-N hubs always labeled
  var THROTTLE_MS   = 250;   // minimum gap between refreshLabelSet() calls
  var CULL_MARGIN   = 20;    // pixels outside viewport to hide a label (avoid pop-in at edges)

  var container  = document.getElementById("kg-labels");
  var spans      = new Map();      // pointIndex → <span>  node-label pool
  var edgeSpans  = new Map();      // neighborPointIndex → <span>  edge-label pool (focus only)
  var labelSet   = [];             // current array of pointIndices being labeled
  var topHubs    = [];             // indices of top HUB_COUNT nodes by degree
  var topHubSet  = new Set();      // fast membership test
  var spacePos   = null;           // Float32Array — cached from getPointPositions()
  var lastThrottle = 0;            // timestamp of last refreshLabelSet() call
  var rafId      = null;

  // ------------------------------------------------------------------ helpers
  function getGraph() {
    return window.kg && window.kg.graph;
  }

  // ------------------------------------------------------------------ hubs
  // Rank nodes by adjacency-list length (each entry is one directed edge
  // endpoint) as a cheap proxy for degree; resolves ties consistently.
  function computeTopHubs() {
    var adj = window.kg && window.kg.adjacency;
    if (!adj || !adj.length) { topHubs = []; topHubSet = new Set(); return; }
    var indexed = adj.map(function(a, i) { return { i: i, deg: a.length }; });
    indexed.sort(function(a, b) { return b.deg - a.deg; });
    topHubs = indexed.slice(0, HUB_COUNT).map(function(x) { return x.i; });
    topHubSet = new Set(topHubs);
  }

  // ------------------------------------------------------------------ span pool
  function ensureSpan(i) {
    if (spans.has(i)) return spans.get(i);
    var sp = document.createElement("span");
    sp.className = "kg-label" + (topHubSet.has(i) ? " kg-label-hub" : "");
    var meta = window.kg && window.kg.nodeMeta && window.kg.nodeMeta[i];
    sp.textContent = meta ? meta.label : String(i);
    sp.style.display = "none";
    container.appendChild(sp);
    spans.set(i, sp);
    return sp;
  }

  // Remove spans that are no longer in labelSet from the DOM and pool.
  function pruneSpans(nextSet) {
    var nextSetObj = new Set(nextSet);
    spans.forEach(function(sp, i) {
      if (!nextSetObj.has(i)) {
        container.removeChild(sp);
        spans.delete(i);
      }
    });
  }

  // ------------------------------------------------------------------ edge-label pool helpers
  function ensureEdgeSpan(nbrIdx, relText) {
    var sp;
    if (edgeSpans.has(nbrIdx)) {
      sp = edgeSpans.get(nbrIdx);
    } else {
      sp = document.createElement("span");
      sp.className = "kg-edge-label";
      sp.style.display = "none";
      container.appendChild(sp);
      edgeSpans.set(nbrIdx, sp);
    }
    sp.textContent = relText;
    return sp;
  }

  function pruneEdgeSpans(keepSet) {
    edgeSpans.forEach(function(sp, nbrIdx) {
      if (!keepSet.has(nbrIdx)) {
        container.removeChild(sp);
        edgeSpans.delete(nbrIdx);
      }
    });
  }

  function clearAllEdgeSpans() {
    edgeSpans.forEach(function(sp) { container.removeChild(sp); });
    edgeSpans.clear();
  }

  // ------------------------------------------------------------------ label set
  // Called on zoom + throttled timer; determines which indices to label.
  function refreshLabelSet() {
    var g = getGraph();
    if (!g) return;

    var focus = window.kg && window.kg.focus;

    if (focus) {
      // --- FOCUS MODE: label focused node + top-30 neighbors (node labels),
      //                 and edge-midpoint relation labels for each neighbor.
      var nextSet = [focus.index];
      var neighborIdxSet = new Set();
      focus.neighbors.forEach(function(nb) {
        if (nb.idx != null) {
          nextSet.push(nb.idx);
          neighborIdxSet.add(nb.idx);
        }
      });

      // Prune node spans not in focus set, ensure spans for focus set.
      pruneSpans(nextSet);
      nextSet.forEach(function(i) {
        var sp = ensureSpan(i);
        sp.className = "kg-label" + (i === focus.index ? " kg-label-hub" : "");
        var meta = window.kg && window.kg.nodeMeta && window.kg.nodeMeta[i];
        sp.textContent = meta ? meta.label : String(i);
      });
      labelSet = nextSet;

      // Ensure edge spans for the top-15 neighbors only (cap to avoid clutter).
      // focus.neighbors is already sorted by article count desc; slice to 15.
      var edgeLabelNeighbors = focus.neighbors.slice(0, 15);
      var edgeLabelIdxSet = new Set();
      edgeLabelNeighbors.forEach(function(nb) {
        if (nb.idx != null) edgeLabelIdxSet.add(nb.idx);
      });
      pruneEdgeSpans(edgeLabelIdxSet);
      edgeLabelNeighbors.forEach(function(nb) {
        if (nb.idx != null) ensureEdgeSpan(nb.idx, nb.relations);
      });
      return;
    }

    // --- DEFAULT MODE (no focus): existing hub + sampled behavior.
    // Clear any stale edge spans from a previous focus.
    clearAllEdgeSpans();

    var sampledMap;
    try { sampledMap = g.getSampledPointPositionsMap(); } catch(e) { return; }
    // Use only the KEY SET of sampledMap (the sampled point indices);
    // do NOT use its values for positioning (coordinate space ambiguous).
    var sampledArr = Array.from(sampledMap.keys());

    // Union: hubs first (they must be included), then sampled, deduped.
    var seen = new Set();
    var combined = [];
    function addIndex(i) {
      if (!seen.has(i)) { seen.add(i); combined.push(i); }
    }
    topHubs.forEach(addIndex);
    sampledArr.forEach(addIndex);
    var nextSet = combined.slice(0, LABEL_MAX);

    // Prune old spans outside next set, then ensure spans exist for next set.
    pruneSpans(nextSet);
    nextSet.forEach(function(i) {
      var sp = ensureSpan(i);
      // Update hub class in case topHubs changed after a rebuild.
      sp.className = "kg-label" + (topHubSet.has(i) ? " kg-label-hub" : "");
      // Always sync label text from live nodeMeta — pooled spans can carry a
      // stale name when a re-filter shifts node indices (bug fix).
      var meta = window.kg && window.kg.nodeMeta && window.kg.nodeMeta[i];
      sp.textContent = meta ? meta.label : String(i);
    });
    labelSet = nextSet;
  }

  // ------------------------------------------------------------------ space positions
  // GPU read — called on rebuild, physics tick, and once at init.
  // NOT called per animation frame.
  function refreshSpacePos() {
    var g = getGraph();
    if (!g) return;
    try { spacePos = g.getPointPositions(); } catch(e) { spacePos = null; }
  }

  // ------------------------------------------------------------------ positioning
  // Runs every animation frame: ~40 projections via spaceToScreenPosition.
  // Culls labels outside the viewport to avoid stale positions at edges.
  function positionLabels() {
    var g = getGraph();
    if (!g || !spacePos) {
      // Hide all until data ready.
      spans.forEach(function(sp) { sp.style.display = "none"; });
      edgeSpans.forEach(function(sp) { sp.style.display = "none"; });
      return;
    }
    var vw = window.innerWidth, vh = window.innerHeight;

    // --- Node labels ---
    for (var li = 0; li < labelSet.length; li++) {
      var i  = labelSet[li];
      var sp = spans.get(i);
      if (!sp) continue;

      var sx = spacePos[2 * i], sy = spacePos[2 * i + 1];
      var screen;
      try { screen = g.spaceToScreenPosition([sx, sy]); } catch(e) {
        sp.style.display = "none"; continue;
      }
      var px = screen[0], py = screen[1];

      // Cull if outside viewport + margin.
      if (px < -CULL_MARGIN || px > vw + CULL_MARGIN ||
          py < -CULL_MARGIN || py > vh + CULL_MARGIN) {
        sp.style.display = "none";
      } else {
        sp.style.left    = px + "px";
        sp.style.top     = py + "px";
        sp.style.display = "";
      }
    }

    // --- Edge labels (focus mode only) ---
    var focus = window.kg && window.kg.focus;
    if (!focus || spacePos.length < 2 * (focus.index + 1)) {
      edgeSpans.forEach(function(sp) { sp.style.display = "none"; });
      return;
    }
    var fi = focus.index;
    var fsx = spacePos[2 * fi], fsy = spacePos[2 * fi + 1];
    // Iterate over edgeSpans (already pruned to top-15 by refreshLabelSet).
    edgeSpans.forEach(function(esp, ni) {
      if (ni == null || ni * 2 + 1 >= spacePos.length) { esp.style.display = "none"; return; }
      // Position at t=0.65 from focused node toward neighbor (de-clusters away from hub center).
      var t = 0.65;
      var ex = fsx + t * (spacePos[2 * ni]     - fsx);
      var ey = fsy + t * (spacePos[2 * ni + 1] - fsy);
      var escreen;
      try { escreen = g.spaceToScreenPosition([ex, ey]); } catch(e) {
        esp.style.display = "none"; return;
      }
      var epx = escreen[0], epy = escreen[1];
      if (epx < -CULL_MARGIN || epx > vw + CULL_MARGIN ||
          epy < -CULL_MARGIN || epy > vh + CULL_MARGIN) {
        esp.style.display = "none";
      } else {
        esp.style.left    = epx + "px";
        esp.style.top     = epy + "px";
        esp.style.display = "";
      }
    });
  }

  // ------------------------------------------------------------------ rAF loop
  function tick() {
    var now = performance.now();
    // Throttled: refresh label set every THROTTLE_MS.
    if (now - lastThrottle > THROTTLE_MS) {
      refreshLabelSet();
      lastThrottle = now;
    }
    // While the simulation is running, refresh space positions each frame so
    // labels follow moving nodes. When paused this is a no-op (cheap).
    var g = getGraph();
    if (g && g.isSimulationRunning) refreshSpacePos();
    positionLabels();
    rafId = requestAnimationFrame(tick);
  }

  // ------------------------------------------------------------------ public API
  // Exposed so buildAndApply (core script) and config callbacks can call in.
  window.kgLabels = {
    // Called by buildAndApply after window.kg.* are fully reassigned.
    // Also clears edge spans because kg.focus is null after rebuild.
    onRebuild: function() {
      clearAllEdgeSpans();
      computeTopHubs();
      refreshSpacePos();
      refreshLabelSet();
      lastThrottle = performance.now();
    },
    // Called by onSimulationTick config callback (driven by physics engine).
    _tick: refreshSpacePos,
    // Called by handleClick when focus state changes (node clicked or bg clicked).
    onFocusChange: function() {
      refreshLabelSet();
      lastThrottle = performance.now();
    },
  };

  // ------------------------------------------------------------------ init
  // Delay init by one frame so window.kg.graph is populated and cosmos has
  // set up its internal state (buildAndApply is synchronous in the prior
  // script, so by the time this IIFE runs the data is already there).
  requestAnimationFrame(function() {
    computeTopHubs();
    refreshSpacePos();
    refreshLabelSet();
    lastThrottle = performance.now();
    rafId = requestAnimationFrame(tick);
  });
})();
</script>
</body>
</html>
